# Path to GCP service account JSON (local development)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json

# Alternative: base64-encoded service account JSON (deployment)
# GCP_SERVICE_ACCOUNT_KEY=

# Optional: BigQuery result cache TTL in seconds (default: 900)
# CACHE_TTL_SECONDS=900

# Research snapshots (POST /api/v1/snapshots). In-memory only; no Hubble call.
# TTL default 604800 seconds (7 days). Bodies larger than 65536 bytes return 413.
# SNAPSHOT_TTL_SECONDS=604800
# SNAPSHOT_MAX_BYTES=65536

# Optional: max BigQuery bytes billed per query job (default: 1073741824 = 1 GB)
# BIGQUERY_MAX_BYTES_BILLED=1073741824

# Data source: live (default, requires GCP) or fixture (local non-live sample data).
# Fixture mode is blocked in production (NODE_ENV/VERCEL_ENV=production).
# LUMENMAP_DATA_SOURCE=fixture

# Optional: comma-separated protocol ids that should use a live Protocol TVL
# adapter instead of their fixture (default: unset — every protocol uses its
# fixture). A protocol id here only takes effect if a live adapter is
# registered for it in lib/tvl/protocol-registry.ts.
# LUMENMAP_TVL_LIVE_ADAPTERS=soroswap

# Dashboard network: mainnet (default) or testnet. Fixture mode can simulate testnet.
# LUMENMAP_NETWORK=mainnet

# Experimental Flow chart view: disabled by default in production; set true to enable.
# In development or fixture mode, `?view=flow&flow=1` opts in for a preview.
# LUMENMAP_ENABLE_FLOW_VIEW=false

# Public API tracing: off (default), console, or otlp. No credentials needed
# for console mode. OTLP uses the standard HTTP traces endpoint by default.
# LUMENMAP_TRACING=off
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# LUMENMAP_BIGQUERY_DATASET=crypto-stellar.crypto_stellar_dbt
# LUMENMAP_MAINNET_BIGQUERY_DATASET=crypto-stellar.crypto_stellar_dbt
# LUMENMAP_TESTNET_BIGQUERY_DATASET=your-project.testnet_dbt

# Optional: use scheduled BigQuery materialized rollups for hot dashboard queries (default: false)
# LUMENMAP_USE_ROLLUPS=false
# LUMENMAP_ROLLUPS_DATASET=lumenmap_rollups
